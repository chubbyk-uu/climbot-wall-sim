Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  # Provided by climbot_rviz_plugins. RViz logs a warning and starts without
  # the panel if that package is not on the workspace, so an unbuilt plugin
  # costs the buttons but never the rest of the visualization.
  - Class: climbot_rviz_plugins/Coverage
    Name: Coverage Task
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Wall Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 10
      Color: 100; 100; 105
      Alpha: 0.5
    - Class: rviz_default_plugins/Axes
      Name: Wall Frame
      Enabled: true
      Reference Frame: <Fixed Frame>
      Length: 1
      Radius: 0.04
    - Class: rviz_default_plugins/RobotModel
      Name: Climbot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Coverage Regions
      Enabled: true
      Topic:
        Value: /coverage/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Coverage Path
      Enabled: true
      Topic:
        Value: /coverage/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Line Style: Lines
      Line Width: 0.03
      Color: 25; 150; 255
    - Class: rviz_default_plugins/Path
      Name: Dynamic Execution Line
      Enabled: true
      Topic:
        Value: /control/reference_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Line Style: Lines
      Line Width: 0.05
      Color: 255; 90; 30
  Global Options:
    Fixed Frame: odom
    Background Color: 36; 39; 46
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
      Single click: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # Framed on the whole 10 x 8 m wall, whose centre is now (W/2, H/2)
      # rather than (0, H/2): the work frame's origin is the lower-left
      # corner.
      Distance: 9
      Focal Point:
        X: 5
        Y: 4
        Z: 0
      # Look at the wall face-on from +Z. Yaw must place the camera on the
      # -Y side, otherwise Ogre's fixed +Z yaw axis resolves screen-right to
      # odom -X and the whole view appears rotated by 180 degrees. Pitch stays
      # just below pi/2 so the up vector is never the degenerate solution.
      Pitch: 1.5
      Yaw: -1.5707
Window Geometry:
  Width: 1200
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: false
  Tool Properties:
    collapsed: false
  Coverage Task:
    collapsed: false
  # Qt's QMainWindow::saveState() hex, restored by dock objectName, which
  # RViz sets to the panel name above. Without it Qt splits the left column
  # evenly and Tool Properties -- two rows of tool settings -- takes as much
  # height as the operator panel. This gives the left column roughly
  # 300 / 90 / 374 px for Displays / Tool Properties / Coverage Task.
  # Regenerate with ../scripts/make_rviz_window_state.py after adding a panel:
  # a stale blob names panels that no longer exist and Qt then falls back
  # to the even split without saying so.
  QMainWindow State: 
