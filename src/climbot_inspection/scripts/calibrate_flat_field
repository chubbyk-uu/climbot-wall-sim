#!/usr/bin/env python3
# Copyright 2026 jerry
# Licensed under the Apache License, Version 2.0

"""Acquire 30 independently triggered frames and write a flat-field NPZ."""

from pathlib import Path
import threading
import time

from cv_bridge import CvBridge
import numpy as np
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image

from climbot_interfaces.srv import CaptureOnce

from climbot_inspection.flat_field import compute_calibration, image_hash


class Calibrator(Node):
    def __init__(self):
        super().__init__('flat_field_calibrator')
        self.declare_parameter('frame_count', 30)
        self.declare_parameter('capture_service', '/inspection/capture_once')
        self.declare_parameter('image_topic', '/inspection/camera/image_raw')
        self.declare_parameter('output_file', '/tmp/climbot_flat_field.npz')
        # The patent uses 128 as an example. The simulated concrete is much
        # less reflective than the calibration board; 172.75 reproduces the
        # established 86.21 DN compensated-wall baseline after the stronger
        # LED / shorter-exposure update, without clipping highlights.
        self.declare_parameter('target_mean_dn', 172.75)
        self.declare_parameter('max_saturated_fraction', 0.0001)
        self.declare_parameter('frame_timeout_s', 8.0)
        self.declare_parameter('readiness_timeout_s', 30.0)
        self.declare_parameter('minimum_capture_interval_s', 0.1)
        self.count = int(self.get_parameter('frame_count').value)
        if self.count < 11:
            raise ValueError('frame_count must be at least 11')
        self.bridge = CvBridge()
        self.frames = []
        self.stamps = set()
        self.hashes = set()
        self.event = threading.Event()
        self.subscription = self.create_subscription(
            Image, str(self.get_parameter('image_topic').value),
            self._on_image, 10)
        self.client = self.create_client(
            CaptureOnce, str(self.get_parameter('capture_service').value))

    def _on_image(self, message):
        stamp = (message.header.stamp.sec, message.header.stamp.nanosec)
        frame = self.bridge.imgmsg_to_cv2(message, desired_encoding='mono8')
        digest = image_hash(frame)
        duplicate_stamp = stamp in self.stamps
        duplicate_content = digest in self.hashes
        if duplicate_stamp or duplicate_content:
            self.get_logger().error(
                'Duplicate frame received: '
                f'timestamp={duplicate_stamp} content={duplicate_content} '
                f'stamp={stamp[0]}.{stamp[1]:09d}')
            self.event.set()
            return
        self.stamps.add(stamp)
        self.hashes.add(digest)
        self.frames.append(frame.copy())
        self.event.set()

    def run(self):
        timeout = float(self.get_parameter('frame_timeout_s').value)
        interval = float(
            self.get_parameter('minimum_capture_interval_s').value)
        readiness_timeout = float(
            self.get_parameter('readiness_timeout_s').value)
        if not 0.04 <= interval <= 5.0:
            raise ValueError(
                'minimum_capture_interval_s must be in [0.04, 5.0]')
        if not 1.0 <= readiness_timeout <= 120.0:
            raise ValueError('readiness_timeout_s must be in [1, 120]')
        if not self.client.wait_for_service(timeout_sec=timeout):
            raise RuntimeError('capture service is unavailable')
        for number in range(self.count):
            self.event.clear()
            before = len(self.frames)
            ready_deadline = time.monotonic() + readiness_timeout
            while True:
                future = self.client.call_async(CaptureOnce.Request())
                rclpy.spin_until_future_complete(
                    self, future, timeout_sec=timeout)
                if not future.done() or future.result() is None:
                    raise RuntimeError(
                        f'capture {number + 1} failed: timeout')
                if future.result().success:
                    break
                detail = future.result().message
                if (future.result().reason != CaptureOnce.Response.WARMING or
                        time.monotonic() >= ready_deadline):
                    raise RuntimeError(
                        f'capture {number + 1} failed: {detail}')
                time.sleep(0.25)
            deadline = time.monotonic() + timeout
            while len(self.frames) == before and time.monotonic() < deadline:
                rclpy.spin_once(self, timeout_sec=0.05)
            if len(self.frames) != before + 1:
                raise RuntimeError(f'capture {number + 1} did not yield one unique frame')
            # Gazebo's triggered sensor can return its cached exposure when a
            # second trigger arrives inside one 30 Hz update period. A real
            # industrial camera also needs exposure/readout time, so enforce
            # a conservative interval and still reject any duplicate above.
            if number + 1 < self.count:
                time.sleep(interval)
        target_mean = float(self.get_parameter('target_mean_dn').value)
        calibration = compute_calibration(
            self.frames, target_mean,
            max_saturated_fraction=float(
                self.get_parameter('max_saturated_fraction').value))
        output = Path(str(self.get_parameter('output_file').value)).expanduser()
        output.parent.mkdir(parents=True, exist_ok=True)
        np.savez_compressed(
            output, gain=calibration.gain, mean_image=calibration.mean_image,
            frame_count=np.int32(self.count),
            unique_timestamps=np.int32(len(self.stamps)),
            unique_hashes=np.int32(calibration.unique_hashes),
            temporal_noise_dn=np.float32(calibration.temporal_noise_dn),
            trimmed_mean_dn=np.float32(calibration.trimmed_mean_dn),
            saturated_fraction=np.float32(calibration.saturated_fraction),
            target_mean_dn=np.float32(target_mean))
        self.get_logger().info(
            f'CALIBRATION_OK frames={self.count} unique_stamps={len(self.stamps)} '
            f'unique_hashes={calibration.unique_hashes} '
            f'noise_dn={calibration.temporal_noise_dn:.3f} '
            f'saturated_fraction={calibration.saturated_fraction:.6f} '
            f'file={output}')


def main():
    rclpy.init()
    node = Calibrator()
    try:
        node.run()
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
