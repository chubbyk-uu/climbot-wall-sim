"""Publish patent-compatible flat-field corrected mono8 images."""

from cv_bridge import CvBridge
import numpy as np
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image

from climbot_inspection.flat_field import apply_calibration


class FlatFieldNode(Node):
    def __init__(self):
        super().__init__('flat_field_node')
        self.declare_parameter('calibration_file', '')
        self.declare_parameter('input_topic', '/inspection/camera/image_raw')
        self.declare_parameter(
            'output_topic', '/inspection/camera/image_compensated')
        path = str(self.get_parameter('calibration_file').value)
        if not path:
            raise ValueError('calibration_file must not be empty')
        with np.load(path, allow_pickle=False) as archive:
            self.gain = archive['gain'].astype(np.float32)
            if int(archive['frame_count']) < 11:
                raise ValueError('calibration used too few frames')
            if int(archive['unique_hashes']) != int(archive['frame_count']):
                raise ValueError('calibration contains duplicate frames')
        self.bridge = CvBridge()
        self.publisher = self.create_publisher(
            Image, str(self.get_parameter('output_topic').value), 10)
        self.subscription = self.create_subscription(
            Image, str(self.get_parameter('input_topic').value),
            self._on_image, 10)

    def _on_image(self, message):
        image = self.bridge.imgmsg_to_cv2(message, desired_encoding='mono8')
        corrected = apply_calibration(image, self.gain)
        output = self.bridge.cv2_to_imgmsg(corrected, encoding='mono8')
        output.header = message.header
        self.publisher.publish(output)


def main():
    rclpy.init()
    try:
        node = FlatFieldNode()
        rclpy.spin(node)
        node.destroy_node()
    finally:
        rclpy.shutdown()


if __name__ == '__main__':
    main()
