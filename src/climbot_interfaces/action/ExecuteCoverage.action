# Goal: a fully validated, immutable CoverageTask.
CoverageTask task
# A task-level decision made by the manager before Goal dispatch. It is not a
# geometry property of CoverageTask: the same preview may be run as motion-only
# or as a formally archived inspection. The executor freezes this value for the
# complete Goal and only enables SCAN references when it is true.
bool inspection_enabled
---
# Result codes.
uint16 SUCCESS=0
uint16 CANCELED=1
uint16 LOCALIZATION_TIMEOUT=3
uint16 CONTROL_TIMEOUT=4
uint16 OUT_OF_BOUNDS=5
uint16 TRACKING_FAILED=6
# The manager lost contact with this executor and released the goal on its own.
# Distinct from CONTROL_TIMEOUT, which is a real timeout the executor itself
# declares: reusing that code reported a cause that had not happened and left
# an operator diagnosing the controller instead of the connection. Only the
# manager ever publishes it; an executor never returns it.
uint16 EXECUTOR_LOST=7
# The robot motion may have completed or stopped safely, but a formal raw-data
# archive failed or is incomplete. Only the manager reports this code.
uint16 ARCHIVE_FAILED=8

uint16 result_code
string message
uint32 completed_segments
float64 elapsed_time_s
---
# Execution state values.
uint8 WAITING=0
uint8 ALIGN=1
uint8 TURN_SETTLE=2
uint8 TRACK_LINE=3
uint8 FINAL_APPROACH=4
uint8 STOPPED=5
uint8 APPROACH_START=6
uint8 PAUSING=7
uint8 PAUSED=8

uint8 state
int32 current_segment
uint8 segment_type
float64 along_track_error
float64 cross_track_error
float64 heading_error
float64 remaining_distance
float32 progress

# The schedule, alongside the progress fraction rather than instead of it.
# progress answers how much of the work is done and never moves while the robot
# is stuck; these answer whether the work is on time, which is a different
# question and would be misleading if folded into the bar.
#
# planned_total_s is fixed when the task starts and covers the approach to the
# first waypoint as well as the segments. schedule_lag_s is positive when the
# robot is behind, and is zero throughout in distance mode, which has no
# schedule to be behind. estimated_remaining_s carries the accumulated lag, so
# it grows when the run falls behind instead of counting steadily down.
float64 planned_total_s
float64 schedule_lag_s
float64 estimated_remaining_s
