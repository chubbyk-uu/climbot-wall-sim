<?xml version="1.0"?>
<package format="3">
  <name>climbot_description</name>
  <version>0.1.0</version>
  <description>Physical description of the wall-climbing robot and its work surface, shared by simulation, planning and control.</description>
  <maintainer email="dk.illidan@gmail.com">jerry</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>pybind11_vendor</depend>
  <depend>yaml-cpp</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
