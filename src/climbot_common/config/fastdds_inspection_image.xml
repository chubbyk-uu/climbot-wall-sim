<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS transport capacity for the inspection image publishers.

  The largest rendered exposure is 1920 x 1080 x 3 = 6220800 bytes. Fast DDS
  splits it into RTPS fragments no larger than maxMessageSize; its stock shared
  memory segment is only about 512 KiB and cannot retain all fragments of even
  one exposure. Under sustained triggering that segment eventually exhausts a
  buffer, and a reliable reader can wait for the three-second periodic heartbeat
  before recovering the missing fragment. A 64 MiB segment provides capacity
  for ten exposure payloads plus roughly 8% headroom for transport bookkeeping.

  Apply this profile only to participants that publish a multi-fragment image:
  inspection_camera_bridge (RGB), camera_distortion_adapter (mono8), and
  capture_once_node (the canonical mono8 archive image). Readers access the
  writer-owned segment and do not need to reserve another 64 MiB segment.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>climbot_inspection_shm</transport_id>
        <type>SHM</type>
        <segment_size>67108864</segment_size>
        <port_queue_capacity>4096</port_queue_capacity>
        <!-- Fragment size, not the complete image size. -->
        <maxMessageSize>524288</maxMessageSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>climbot_inspection_udp</transport_id>
        <type>UDPv4</type>
        <!-- Kept for discovery and for any peer without shared memory. The
             kernel clamps these to net.core.rmem_max / wmem_max. -->
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="climbot_inspection_image" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>climbot_inspection_shm</transport_id>
          <transport_id>climbot_inspection_udp</transport_id>
        </userTransports>
        <!-- Replacing rather than adding: two shared-memory transports on one
             participant would race for the same port. -->
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
