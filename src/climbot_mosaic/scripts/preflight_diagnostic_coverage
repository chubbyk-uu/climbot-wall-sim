"""Verify diagnostic feature coverage from a task before collecting data."""

import argparse
import hashlib
import json
from pathlib import Path

from climbot_mosaic.diagnostic_coverage_preflight import (
    DiagnosticCoveragePreflightError,
    load_preflight_inputs,
    preflight_diagnostic_coverage,
    preflight_diagnostic_coverage_set,
    write_preflight_report,
)


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()


def _input_record(path: Path) -> dict:
    """Keep provenance without embedding the caller's private absolute directory."""
    return {'file_name': path.name, 'sha256': _sha256(path)}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--task-config', required=True, type=Path, action='append')
    parser.add_argument('--wall-manifest', required=True, type=Path)
    parser.add_argument('--camera-config', required=True, type=Path)
    parser.add_argument('--robot-config', required=True, type=Path)
    parser.add_argument('--wall-config', required=True, type=Path)
    parser.add_argument('--output', type=Path)
    parser.add_argument('--resolution-m', type=float, default=0.001)
    arguments = parser.parse_args()
    try:
        inputs = [load_preflight_inputs(config, arguments.wall_manifest,
                                        arguments.camera_config, arguments.robot_config,
                                        arguments.wall_config)
                  for config in arguments.task_config]
        if len(inputs) == 1:
            report = preflight_diagnostic_coverage(*inputs[0], arguments.resolution_m)
            task_id = report['task']['task_id']
            exposure_count = report['task']['exposure_count']
        else:
            task, wall_manifest, camera, robot, wall = inputs[0]
            if any(values[1:] != (wall_manifest, camera, robot, wall) for values in inputs[1:]):
                raise DiagnosticCoveragePreflightError('complementary tasks must use identical static inputs.')
            report = preflight_diagnostic_coverage_set(
                tuple(values[0] for values in inputs), wall_manifest, camera, robot, wall,
                arguments.resolution_m)
            task_id = ','.join(str(item['task_id']) for item in report['task_set']['tasks'])
            exposure_count = report['task_set']['exposure_count']
        report['inputs'] = {
            'task_configs': [_input_record(path) for path in arguments.task_config],
            'wall_manifest': _input_record(arguments.wall_manifest),
            'camera_config': _input_record(arguments.camera_config),
            'robot_config': _input_record(arguments.robot_config),
            'wall_config': _input_record(arguments.wall_config),
        }
        if arguments.output is not None:
            write_preflight_report(arguments.output, report)
    except (DiagnosticCoveragePreflightError, OSError, ValueError) as error:
        print(f'diagnostic coverage preflight failed: {error}')
        return 2
    print(json.dumps({
        'status': 'completed',
        'task_id': task_id,
        'exposure_count': exposure_count,
        'all_intersecting_feature_samples_covered': report['feature_coverage'][
            'all_intersecting_feature_samples_covered'],
        'uncovered_sample_count': report['feature_coverage']['uncovered_sample_count'],
    }, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
