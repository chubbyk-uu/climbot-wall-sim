"""CLI for strict, side-effect-free processed-run mosaic preflight."""

import argparse
import json
from pathlib import Path
import sys

from climbot_mosaic.mosaic_inputs import (
    MosaicInputError,
    input_summary,
    validate_processed_runs,
)


def main() -> int:
    """Validate one or more processed runs and print a strict JSON summary."""
    parser = argparse.ArgumentParser(
        description='Validate completed Climbot processed archives for wall mosaicking.')
    parser.add_argument('--input-run', action='append', required=True, type=Path,
                        help='Absolute processed-run directory; repeat for a joint mosaic.')
    arguments = parser.parse_args()
    try:
        summary = input_summary(validate_processed_runs(arguments.input_run))
    except MosaicInputError as error:
        print(f'mosaic input validation failed: {error}', file=sys.stderr)
        return 2
    print(json.dumps(summary, allow_nan=False, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
