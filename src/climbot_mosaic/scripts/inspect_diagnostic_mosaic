"""Export native-scale diagnostic feature and seam inspection evidence."""

import argparse
import json
import os
from pathlib import Path

from climbot_mosaic.diagnostic_inspection import (
    DiagnosticInspectionError,
    inspect_diagnostic_mosaic,
)
from climbot_mosaic.evidence_chain import EvidenceChainError, resolve_frozen_tasks


def _frozen_domain(mosaic_dir, input_runs, archive_root):
    """
    Take the acceptance domain out of the evidence rather than off the command line.

    The region and the footprint used to be typed in, which let whoever ran the
    checker choose what the run was judged against.  Both now come from the
    frozen task snapshots the archives carry, every link verified by digest.
    Tasks that disagree are refused by name: a joint mosaic judged against one
    of two different regions would be judged against neither, and a union is
    not written here because no task has yet needed one.
    """
    tasks = resolve_frozen_tasks(mosaic_dir, tuple(input_runs), archive_root)['tasks']
    regions = {task['coverage_region_m'] for task in tasks}
    footprints = {task['camera_footprint_m'] for task in tasks}
    if len(regions) != 1 or len(footprints) != 1:
        raise EvidenceChainError(
            'frozen tasks disagree about the inspection region or camera footprint: '
            + ', '.join(sorted(str(task['task_id']) for task in tasks)))
    return regions.pop(), footprints.pop(), tasks


def main() -> int:
    """Write a new atomic inspection directory from completed mosaic products."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mosaic-dir', required=True, type=Path)
    parser.add_argument('--wall-manifest', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    parser.add_argument('--padding-m', type=float, default=0.05)
    parser.add_argument('--tile-size-px', type=int, default=2048)
    # The processed runs this mosaic was built from. They are named rather than
    # read out of the mosaic manifest because that manifest records run
    # identity without host paths; naming the wrong one is caught by digest.
    parser.add_argument('--input-run', action='append', required=True, type=Path)
    parser.add_argument('--archive-root', type=Path,
                        default=Path(os.environ.get('CLIMBOT_DATA_ROOT',
                                                    Path.home() / 'climbot_data')))
    arguments = parser.parse_args()
    try:
        region, footprint, tasks = _frozen_domain(
            arguments.mosaic_dir, arguments.input_run, arguments.archive_root)
    except EvidenceChainError as error:
        print(f'inspection region could not be recovered from the evidence: {error}')
        return 2
    try:
        summary = inspect_diagnostic_mosaic(
            arguments.mosaic_dir, arguments.wall_manifest, arguments.output_dir,
            arguments.padding_m, arguments.tile_size_px, region, footprint, tasks)
    except (DiagnosticInspectionError, OSError, ValueError) as error:
        print(f'diagnostic mosaic inspection failed: {error}')
        return 2
    coverage = summary['visible_feature_coverage']
    report = {
        'status': 'completed',
        'output_dir': str(arguments.output_dir),
        'visible_feature_pixels_covered': coverage['all_visible_feature_pixels_covered'],
        'intersecting_feature_count': summary['feature_counts'][
            'intersecting_mosaic_domain'],
        'frozen_task_ids': sorted(str(task['task_id']) for task in tasks),
        'inspection_region_feature_pixels_covered': coverage[
            'all_inspection_region_feature_pixels_covered'],
        'feature_pixels_inside_inspection_region': coverage[
            'feature_pixels_inside_inspection_region'],
        'uncovered_inside_inspection_region': coverage['uncovered_inside_inspection_region'],
        'uncovered_outside_inspection_region': coverage['uncovered_outside_inspection_region'],
        'uncovered_outside_region_inside_planned_scan_footprint': coverage[
            'uncovered_outside_region_inside_planned_scan_footprint'],
        'uncovered_outside_region_outside_planned_scan_footprint': coverage[
            'uncovered_outside_region_outside_planned_scan_footprint'],
        'uncovered_outside_region_inside_safe_pose_envelope': coverage[
            'uncovered_outside_region_inside_safe_pose_envelope'],
        'uncovered_outside_region_outside_safe_pose_envelope': coverage[
            'uncovered_outside_region_outside_safe_pose_envelope'],
    }
    print(json.dumps(report, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
