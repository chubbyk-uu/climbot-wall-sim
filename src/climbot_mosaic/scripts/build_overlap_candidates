"""Build deterministic spatial overlap candidates from P2.2/P2.3 evidence."""

import argparse
import json
from pathlib import Path
import sys
import tempfile
from uuid import uuid4

from climbot_mosaic.candidates import CandidateError, build_overlap_candidates
from climbot_mosaic.mosaic_inputs import MosaicInputError, input_summary, validate_processed_runs
from climbot_mosaic.projection import ProjectionError, project_inputs
from climbot_mosaic.stage_provenance import processed_run_inputs, write_stage_provenance


def main() -> int:
    """Validate archives, rederive P2.3 footprints and atomically save candidate pairs."""
    parser = argparse.ArgumentParser(
        description='Build exact wall-footprint overlap candidates for visual matching.')
    parser.add_argument('--input-run', action='append', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    parser.add_argument('--min-overlap-area-m2', type=float, default=0.0)
    arguments = parser.parse_args()
    try:
        inputs = validate_processed_runs(arguments.input_run)
        output = arguments.output_dir
        if not output.is_absolute() or output.exists() or not output.parent.is_dir():
            raise CandidateError('output directory must be absolute, new and have an existing parent.')
        for run in inputs.runs:
            if output.is_relative_to(run.root):
                raise CandidateError('output directory cannot be inside an input run.')
        candidates = build_overlap_candidates(
            project_inputs(inputs), arguments.min_overlap_area_m2)
        document = {'candidate_format_version': 1, 'input_summary': input_summary(inputs),
                    'min_overlap_area_m2': arguments.min_overlap_area_m2,
                    'candidate_count': len(candidates), 'candidates': [{
                        'first': [item.first.source_run_id, item.first.frame_index],
                        'second': [item.second.source_run_id, item.second.frame_index],
                        'overlap_area_m2': item.overlap_area_m2,
                        'smaller_footprint_overlap_ratio': item.smaller_footprint_overlap_ratio,
                        'intersection_xy_m': [list(point) for point in item.intersection_xy_m],
                    } for item in candidates]}
        temporary = Path(tempfile.mkdtemp(prefix=f'.{output.name}.tmp-{uuid4().hex}-',
                                          dir=output.parent))
        (temporary / 'overlap_candidates.json').write_text(
            json.dumps(document, allow_nan=False, ensure_ascii=False, indent=2, sort_keys=True) + '\n',
            encoding='utf-8')
        write_stage_provenance(
            temporary, 'overlap_candidates',
            {'min_overlap_area_m2': arguments.min_overlap_area_m2},
            processed_run_inputs(document['input_summary']),
            ('overlap_candidates.json',))
        temporary.replace(output)
    except (MosaicInputError, ProjectionError, CandidateError, OSError) as error:
        print(f'candidate construction failed: {error}', file=sys.stderr)
        return 2
    print(json.dumps({'status': 'valid', 'candidate_count': len(candidates),
                      'output_dir': str(output)}, allow_nan=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
