"""Publish what an archive's raw frames contain, and gate it against a reference."""

import argparse
import json
from pathlib import Path
import sys

from climbot_mosaic.archive_content import ArchiveContentError, summarize_archive_content


def main() -> int:
    """Write one hashed content record for the given archive runs."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--input-run', action='append', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    parser.add_argument('--reference-run', type=Path,
                        help='archive run of the same plan whose content is the baseline')
    parser.add_argument('--scalar-tolerance', type=float, default=0.05)
    parser.add_argument('--profile-tolerance', type=float, default=0.02)
    arguments = parser.parse_args()
    try:
        summary = summarize_archive_content(
            arguments.input_run, arguments.output_dir, arguments.reference_run,
            arguments.scalar_tolerance, arguments.profile_tolerance)
    except (ArchiveContentError, OSError, ValueError) as error:
        print(f'archive content summary failed: {error}', file=sys.stderr)
        return 2
    matched = summary.get('all_runs_match_reference')
    print(json.dumps({'output_dir': str(arguments.output_dir.resolve()),
                      'runs': len(summary['runs']),
                      'all_runs_match_reference': matched}, sort_keys=True))
    return 0 if matched is not False else 3


if __name__ == '__main__':
    raise SystemExit(main())
