"""Build pose-only and globally optimized tiled wall mosaics."""

import argparse
import json
from pathlib import Path

from climbot_mosaic.fusion import build_wall_mosaic, FusionError, resolve_jobs
from climbot_mosaic.mosaic_inputs import MosaicInputError, validate_processed_runs
from climbot_mosaic.projection import ProjectionError


def _jobs(value: str) -> int | None:
    if value == 'auto':
        return None
    try:
        result = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError('jobs must be auto or a positive integer.') from error
    if result <= 0:
        raise argparse.ArgumentTypeError('jobs must be auto or a positive integer.')
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description='Build comparable tiled Climbot wall mosaics.')
    parser.add_argument('--input-run', action='append', required=True, type=Path)
    parser.add_argument('--pose-graph-dir', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    parser.add_argument('--work-dir', required=True, type=Path)
    parser.add_argument('--resolution-mm-per-pixel', type=float, default=0.25)
    parser.add_argument('--jobs', type=_jobs, default=None, metavar='auto|N')
    parser.add_argument('--memory-budget-gb', type=float, default=4.0)
    parser.add_argument(
        '--preview-max-side-px', type=int, default=4096,
        help='Longest edge of each JPEG preview panel (default: 4096; minimum: 512).')
    arguments = parser.parse_args()
    try:
        jobs = resolve_jobs(arguments.jobs, arguments.memory_budget_gb)
        manifest = build_wall_mosaic(
            arguments.output_dir, arguments.work_dir,
            validate_processed_runs(arguments.input_run), arguments.pose_graph_dir,
            arguments.resolution_mm_per_pixel / 1000.0,
            jobs, arguments.memory_budget_gb, arguments.preview_max_side_px)
    except (MosaicInputError, ProjectionError, FusionError, OSError, ValueError) as error:
        print(f'wall mosaic failed: {error}')
        return 2
    print(json.dumps({'status': 'completed', 'output_dir': str(arguments.output_dir),
                      'grid': manifest['grid'], 'outputs': manifest['outputs']},
                     allow_nan=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
