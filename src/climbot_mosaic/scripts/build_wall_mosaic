"""Select an isolated fusion backend, then launch its clean worker process."""

import argparse
import json
from pathlib import Path
import sys

from climbot_common.acceleration import (
    AccelerationError,
    cpu_child_environment,
    execute_backend,
    parse_backend,
    run_json_child,
)


def _jobs(value: str) -> int | None:
    if value == 'auto':
        return None
    try:
        result = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError('jobs must be auto or a positive integer.') from error
    if result <= 0:
        raise argparse.ArgumentTypeError('jobs must be auto or a positive integer.')
    return result


def _backend(value: str) -> str:
    try:
        return parse_backend(value)
    except AccelerationError as error:
        raise argparse.ArgumentTypeError(str(error)) from error


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description='Build comparable tiled Climbot wall mosaics.')
    parser.add_argument('--input-run', action='append', required=True, type=Path)
    parser.add_argument('--pose-graph-dir', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    parser.add_argument('--work-dir', required=True, type=Path)
    parser.add_argument('--resolution-mm-per-pixel', type=float, default=0.25)
    parser.add_argument('--jobs', type=_jobs, default=None, metavar='auto|N')
    parser.add_argument('--memory-budget-gb', type=float, default=4.0)
    parser.add_argument(
        '--preview-max-side-px', type=int, default=4096,
        help='Longest edge of each JPEG preview panel (default: 4096; minimum: 512).')
    parser.add_argument('--backend', type=_backend, default='cpu',
                        help='Execution backend: cpu (default), cuda, or auto.')
    return parser


def _cpu_execution(requested: str, fallback: dict | None) -> dict:
    attempts = []
    if fallback is not None:
        attempts.append(fallback)
    result = {'requested': requested, 'effective': 'cpu', 'fallback': fallback is not None,
              'attempts': attempts}
    if fallback is not None:
        result['fallback_reason'] = fallback['error']
    return result


def main() -> int:
    arguments = _parser().parse_args()
    requested = arguments.backend
    fallback: list[dict | None] = [None]

    def cpu_attempt() -> dict:
        request = {
            'input_runs': [str(path) for path in arguments.input_run],
            'pose_graph_dir': str(arguments.pose_graph_dir),
            'output_dir': str(arguments.output_dir),
            'work_dir': str(arguments.work_dir),
            'resolution_m_per_pixel': arguments.resolution_mm_per_pixel / 1000.0,
            'jobs': arguments.jobs,
            'memory_budget_gb': arguments.memory_budget_gb,
            'preview_max_side_px': arguments.preview_max_side_px,
            'execution': _cpu_execution(requested, fallback[0]),
        }
        return run_json_child(
            (sys.executable, '-m', 'climbot_mosaic.mosaic_worker'), request,
            environment=cpu_child_environment(), timeout_s=1800.0)

    def cuda_attempt() -> dict:
        request = {
            'input_runs': [str(path) for path in arguments.input_run],
            'pose_graph_dir': str(arguments.pose_graph_dir),
            'output_dir': str(arguments.output_dir),
            'work_dir': str(arguments.work_dir),
            'resolution_m_per_pixel': arguments.resolution_mm_per_pixel / 1000.0,
            'jobs': arguments.jobs,
            'memory_budget_gb': arguments.memory_budget_gb,
            'preview_max_side_px': arguments.preview_max_side_px,
            'execution': {
                'requested': requested, 'effective': 'cuda', 'fallback': False,
                'attempts': [],
            },
        }
        try:
            return run_json_child(
                (sys.executable, '-m', 'climbot_mosaic.mosaic_cuda_worker'), request,
                environment=cpu_child_environment(), timeout_s=1800.0)
        except AccelerationError as error:
            fallback[0] = {
                'backend': 'cuda', 'outcome': 'failed',
                'error': {'category': error.category, 'message': str(error)}}
            raise
    try:
        result = execute_backend(requested, cpu_attempt, cuda_attempt)
    except AccelerationError as error:
        print(f'wall mosaic failed: {error}', file=sys.stderr)
        return 2
    response = dict(result.value)
    # Keep the public CLI response compatible with the pre-controller command.
    response['output_dir'] = str(arguments.output_dir)
    print(json.dumps(response, allow_nan=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
