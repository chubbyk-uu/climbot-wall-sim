"""Evaluate a hard-cut mosaic against immutable diagnostic-wall visual truth."""

import argparse
import json
from pathlib import Path

from climbot_mosaic.diagnostic_truth import DiagnosticTruthError, evaluate_diagnostic_mosaic


def main() -> int:
    """Parse the offline-only truth inputs and write one atomic evidence directory."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mosaic-dir', required=True, type=Path)
    parser.add_argument('--wall-manifest', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    parser.add_argument('--anchor-padding-m', type=float, default=0.10)
    parser.add_argument('--minimum-phase-response', type=float, default=0.10)
    parser.add_argument('--seam-normal-radius-px', type=int, default=20)
    parser.add_argument('--seam-minimum-truth-gradient', type=float, default=16.0)
    arguments = parser.parse_args()
    try:
        summary = evaluate_diagnostic_mosaic(
            arguments.mosaic_dir, arguments.wall_manifest, arguments.output_dir,
            arguments.anchor_padding_m, arguments.minimum_phase_response,
            arguments.seam_normal_radius_px, arguments.seam_minimum_truth_gradient)
    except (DiagnosticTruthError, OSError, ValueError) as error:
        print(f'diagnostic mosaic evaluation failed: {error}')
        return 2
    print(json.dumps({
        'status': 'completed', 'output_dir': str(arguments.output_dir),
        'anchor_count': len(summary['common_accepted_anchor_ids']),
        'optimized_not_worse_p95_anchor_offset': summary[
            'optimized_not_worse_p95_anchor_offset'],
    }, ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
