<?xml version="1.0"?>
<package format="3">
  <name>climbot_mosaic</name>
  <version>0.1.0</version>
  <description>Offline, traceable wall-mosaic validation and reconstruction.</description>
  <maintainer email="dk.illidan@gmail.com">jerry</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>pybind11_vendor</build_depend>

  <exec_depend>climbot_common</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-tifffile</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
