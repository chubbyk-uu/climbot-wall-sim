<?xml version="1.0"?>
<!--
  Rendered at launch time from climbot_description/config/robot.yaml and the
  Gazebo-only config/simulation.yaml. No dimension may be restated here.
-->
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="base_length" default="0.52"/>
  <xacro:arg name="base_width" default="0.44"/>
  <xacro:arg name="base_thickness" default="0.10"/>
  <xacro:arg name="base_mass" default="12.0"/>
  <xacro:arg name="base_x" default="-0.11"/>
  <xacro:arg name="base_y" default="0.0"/>
  <xacro:arg name="base_z" default="0.085"/>
  <xacro:arg name="wheel_radius" default="0.08"/>
  <xacro:arg name="wheel_width" default="0.045"/>
  <xacro:arg name="wheel_mass" default="1.0"/>
  <xacro:arg name="wheel_axle_x" default="0.0"/>
  <xacro:arg name="wheel_separation" default="0.43"/>
  <xacro:arg name="wheel_mu" default="1.1"/>
  <xacro:arg name="slip_lateral" default="0.12"/>
  <xacro:arg name="slip_longitudinal" default="0.04"/>
  <xacro:arg name="nominal_normal_force" default="77.0"/>
  <xacro:arg name="caster_radius" default="0.05"/>
  <xacro:arg name="caster_mass" default="0.5"/>
  <xacro:arg name="caster_x" default="-0.33"/>
  <xacro:arg name="caster_mu" default="0.35"/>
  <xacro:arg name="camera_body_size_x" default="0.10"/>
  <xacro:arg name="camera_body_size_y" default="0.14"/>
  <xacro:arg name="camera_body_size_z" default="0.08"/>
  <xacro:arg name="camera_body_mass" default="1.5"/>
  <xacro:arg name="camera_body_x" default="0.340"/>
  <xacro:arg name="camera_body_y" default="0.000"/>
  <xacro:arg name="camera_body_z" default="0.315"/>
  <xacro:arg name="camera_optical_x" default="0.340"/>
  <xacro:arg name="camera_optical_y" default="0.000"/>
  <xacro:arg name="camera_optical_z" default="0.275"/>
  <xacro:arg name="camera_optical_roll" default="3.141592653589793"/>
  <xacro:arg name="camera_optical_pitch" default="0.0"/>
  <xacro:arg name="camera_optical_yaw" default="-1.5707963267948966"/>
  <xacro:arg name="camera_bracket_mass" default="0.5"/>
  <xacro:arg name="camera_bracket_x" default="0.220"/>
  <xacro:arg name="camera_bracket_y" default="0.000"/>
  <xacro:arg name="camera_bracket_z" default="0.247"/>
  <xacro:arg name="camera_bracket_inertia_x" default="0.20"/>
  <xacro:arg name="camera_bracket_inertia_y" default="0.12"/>
  <xacro:arg name="camera_bracket_inertia_z" default="0.17"/>
  <xacro:arg name="camera_bracket_upright_size_x" default="0.04"/>
  <xacro:arg name="camera_bracket_upright_size_y" default="0.12"/>
  <xacro:arg name="camera_bracket_upright_size_z" default="0.14"/>
  <xacro:arg name="camera_bracket_upright_x" default="0.170"/>
  <xacro:arg name="camera_bracket_upright_y" default="0.000"/>
  <xacro:arg name="camera_bracket_upright_z" default="0.205"/>
  <xacro:arg name="camera_bracket_arm_size_x" default="0.18"/>
  <xacro:arg name="camera_bracket_arm_size_y" default="0.12"/>
  <xacro:arg name="camera_bracket_arm_size_z" default="0.03"/>
  <xacro:arg name="camera_bracket_arm_x" default="0.265"/>
  <xacro:arg name="camera_bracket_arm_y" default="0.000"/>
  <xacro:arg name="camera_bracket_arm_z" default="0.300"/>
  <xacro:arg name="camera_image_width" default="1920"/>
  <xacro:arg name="camera_image_height" default="1080"/>
  <xacro:arg name="camera_render_fx" default="796.8"/>
  <xacro:arg name="camera_render_fy" default="796.8"/>
  <xacro:arg name="camera_render_hfov" default="1.756056982795549"/>
  <xacro:arg name="camera_cx" default="959.5"/>
  <xacro:arg name="camera_cy" default="539.5"/>
  <xacro:arg name="camera_skew" default="0.0"/>
  <xacro:arg name="camera_triggered" default="true"/>
  <xacro:arg name="camera_update_rate" default="30.0"/>
  <xacro:arg name="camera_image_format" default="R8G8B8"/>
  <xacro:arg name="camera_near_clip" default="0.05"/>
  <xacro:arg name="camera_far_clip" default="20.0"/>
  <xacro:arg name="camera_noise_mean" default="0.0"/>
  <xacro:arg name="camera_noise_stddev" default="0.004"/>
  <xacro:arg name="camera_visualize" default="false"/>
  <xacro:arg name="inspection_led_x" default="0.380"/>
  <xacro:arg name="inspection_led_y" default="0.000"/>
  <xacro:arg name="inspection_led_z" default="0.290"/>
  <xacro:arg name="inspection_led_direction_x" default="0.0"/>
  <xacro:arg name="inspection_led_direction_y" default="0.0"/>
  <xacro:arg name="inspection_led_direction_z" default="-1.0"/>
  <xacro:arg name="inspection_led_intensity" default="1.2"/>
  <xacro:arg name="inspection_led_range" default="2.0"/>
  <xacro:arg name="inspection_led_constant" default="0.20"/>
  <xacro:arg name="inspection_led_linear" default="0.35"/>
  <xacro:arg name="inspection_led_quadratic" default="1.8"/>
  <xacro:arg name="inspection_led_inner_angle" default="0.35"/>
  <xacro:arg name="inspection_led_outer_angle" default="2.05"/>
  <xacro:arg name="inspection_led_falloff" default="0.55"/>
  <xacro:arg name="inspection_led_cast_shadows" default="true"/>
  <xacro:arg name="max_linear_velocity" default="0.30"/>
  <xacro:arg name="max_angular_velocity" default="1.20"/>
  <xacro:arg name="max_linear_acceleration" default="0.40"/>
  <xacro:arg name="max_angular_acceleration" default="1.50"/>
  <xacro:arg name="joint_effort" default="80.0"/>
  <xacro:arg name="joint_velocity" default="30.0"/>
  <xacro:arg name="joint_damping" default="0.05"/>
  <xacro:arg name="odom_frequency" default="50.0"/>
  <xacro:arg name="imu_rate" default="100.0"/>
  <xacro:arg name="imu_gyro_stddev" default="0.0002"/>
  <xacro:arg name="imu_accel_stddev" default="0.017"/>
  <xacro:arg name="contact_rate" default="1000.0"/>

  <xacro:property name="length" value="$(arg base_length)"/>
  <xacro:property name="width" value="$(arg base_width)"/>
  <xacro:property name="thickness" value="$(arg base_thickness)"/>
  <xacro:property name="base_mass" value="$(arg base_mass)"/>
  <xacro:property name="base_x" value="$(arg base_x)"/>
  <xacro:property name="base_y" value="$(arg base_y)"/>
  <xacro:property name="base_z" value="$(arg base_z)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
  <xacro:property name="wheel_mass" value="$(arg wheel_mass)"/>
  <xacro:property name="wheel_axle_x" value="$(arg wheel_axle_x)"/>
  <xacro:property name="half_track" value="${$(arg wheel_separation) / 2.0}"/>
  <xacro:property name="caster_radius" value="$(arg caster_radius)"/>
  <xacro:property name="caster_mass" value="$(arg caster_mass)"/>

  <!-- Solid-box, solid-cylinder and solid-sphere inertias, so a size change
       never leaves a stale inertia tensor behind. -->
  <xacro:property name="base_ixx" value="${base_mass * (width * width + thickness * thickness) / 12.0}"/>
  <xacro:property name="base_iyy" value="${base_mass * (length * length + thickness * thickness) / 12.0}"/>
  <xacro:property name="base_izz" value="${base_mass * (length * length + width * width) / 12.0}"/>
  <xacro:property name="wheel_ixx" value="${wheel_mass * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12.0}"/>
  <xacro:property name="wheel_izz" value="${wheel_mass * wheel_radius * wheel_radius / 2.0}"/>
  <xacro:property name="caster_i" value="${0.4 * caster_mass * caster_radius * caster_radius}"/>
  <xacro:property name="camera_body_ixx" value="${float('$(arg camera_body_mass)') * (float('$(arg camera_body_size_y)')**2 + float('$(arg camera_body_size_z)')**2) / 12.0}"/>
  <xacro:property name="camera_body_iyy" value="${float('$(arg camera_body_mass)') * (float('$(arg camera_body_size_x)')**2 + float('$(arg camera_body_size_z)')**2) / 12.0}"/>
  <xacro:property name="camera_body_izz" value="${float('$(arg camera_body_mass)') * (float('$(arg camera_body_size_x)')**2 + float('$(arg camera_body_size_y)')**2) / 12.0}"/>
  <xacro:property name="camera_bracket_ixx" value="${float('$(arg camera_bracket_mass)') * (float('$(arg camera_bracket_inertia_y)')**2 + float('$(arg camera_bracket_inertia_z)')**2) / 12.0}"/>
  <xacro:property name="camera_bracket_iyy" value="${float('$(arg camera_bracket_mass)') * (float('$(arg camera_bracket_inertia_x)')**2 + float('$(arg camera_bracket_inertia_z)')**2) / 12.0}"/>
  <xacro:property name="camera_bracket_izz" value="${float('$(arg camera_bracket_mass)') * (float('$(arg camera_bracket_inertia_x)')**2 + float('$(arg camera_bracket_inertia_y)')**2) / 12.0}"/>

  <xacro:macro name="drive_wheel" params="side sign">
    <link name="${side}_wheel_link">
      <pose>${wheel_axle_x} ${sign * half_track} ${wheel_radius} 1.57079632679 0 0</pose>
      <inertial>
        <mass>${wheel_mass}</mass>
        <inertia>
          <ixx>${wheel_ixx}</ixx>
          <iyy>${wheel_ixx}</iyy>
          <izz>${wheel_izz}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="${side}_wheel_collision">
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>${wheel_width}</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>$(arg wheel_mu)</mu>
              <mu2>$(arg wheel_mu)</mu2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="${side}_wheel_visual">
        <geometry>
          <cylinder>
            <radius>${wheel_radius}</radius>
            <length>${wheel_width}</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <!-- Wall-contact normal load, recorded for the load-distribution test.
           Evaluation only: no control loop consumes this. -->
      <sensor name="${side}_wheel_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>$(arg contact_rate)</update_rate>
        <contact>
          <collision>${side}_wheel_collision</collision>
        </contact>
      </sensor>
    </link>

    <joint name="${side}_wheel_joint" type="revolute">
      <parent>chassis_link</parent>
      <child>${side}_wheel_link</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>$(arg joint_effort)</effort>
          <velocity>$(arg joint_velocity)</velocity>
        </limit>
        <dynamics>
          <damping>$(arg joint_damping)</damping>
        </dynamics>
      </axis>
    </joint>
  </xacro:macro>

  <model name="climbot" canonical_link="chassis_link">
    <self_collide>false</self_collide>

    <!--
      Robot frame follows REP 103: +X forward, +Y left, +Z away from
      the driving surface. The world rotates this model onto the wall.
    -->
    <!--
      The model origin is the drive axle midpoint at the wall contact plane, so
      the pose Gazebo reports is the point a differential drive rotates about
      and an in-place turn no longer swings it.

      This chassis link keeps its origin at the body centre because
      ApplyLinkWrench applies the suction at the canonical link's ORIGIN, not
      at its centre of mass. Moving this origin moves the suction, and putting
      it on the axle drops the rear caster to zero normal load.
    -->
    <link name="chassis_link">
      <pose>${base_x} ${base_y} ${base_z} 0 0 0</pose>
      <inertial>
        <mass>${base_mass}</mass>
        <inertia>
          <ixx>${base_ixx}</ixx>
          <iyy>${base_iyy}</iyy>
          <izz>${base_izz}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box>
            <size>${length} ${width} ${thickness}</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box>
            <size>${length} ${width} ${thickness}</size>
          </box>
        </geometry>
        <material>
          <ambient>0.66 0.31 0.03 1</ambient>
          <diffuse>0.95 0.45 0.05 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="front_marker">
        <pose>${length / 2.0 - 0.03} 0 ${thickness / 2.0 + 0.011} 0 0 0</pose>
        <geometry>
          <box>
            <size>0.07 ${width * 0.41} 0.025</size>
          </box>
        </geometry>
        <!-- Dark, not orange: it has to stay readable against the orange
             chassis. Matches marker_dark in climbot.urdf.xacro. -->
        <material>
          <ambient>0.08 0.09 0.10 1</ambient>
          <diffuse>0.12 0.13 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Mounted on the chassis; the ROS-side frame is base_link, which
           robot_state_publisher places at the model origin. -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>$(arg imu_rate)</update_rate>
        <topic>/imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>$(arg imu_gyro_stddev)</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>$(arg imu_gyro_stddev)</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>$(arg imu_gyro_stddev)</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>$(arg imu_accel_stddev)</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>$(arg imu_accel_stddev)</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>$(arg imu_accel_stddev)</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <xacro:drive_wheel side="left" sign="1"/>
    <xacro:drive_wheel side="right" sign="-1"/>

    <link name="caster_ball_link">
      <pose>$(arg caster_x) 0 ${caster_radius} 0 0 0</pose>
      <inertial>
        <mass>${caster_mass}</mass>
        <inertia>
          <ixx>${caster_i}</ixx>
          <iyy>${caster_i}</iyy>
          <izz>${caster_i}</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry>
          <sphere>
            <radius>${caster_radius}</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>$(arg caster_mu)</mu>
              <mu2>$(arg caster_mu)</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_visual">
        <geometry>
          <sphere>
            <radius>${caster_radius}</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

      <sensor name="caster_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>$(arg contact_rate)</update_rate>
        <contact>
          <collision>caster_collision</collision>
        </contact>
      </sensor>
    </link>

    <joint name="caster_ball_joint" type="ball">
      <parent>chassis_link</parent>
      <child>caster_ball_link</child>
    </joint>

    <link name="inspection_camera_bracket_link">
      <pose>$(arg camera_bracket_x) $(arg camera_bracket_y) $(arg camera_bracket_z) 0 0 0</pose>
      <inertial>
        <mass>$(arg camera_bracket_mass)</mass>
        <inertia>
          <ixx>${camera_bracket_ixx}</ixx>
          <iyy>${camera_bracket_iyy}</iyy>
          <izz>${camera_bracket_izz}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="upright_visual">
        <pose>${float('$(arg camera_bracket_upright_x)') - float('$(arg camera_bracket_x)')} ${float('$(arg camera_bracket_upright_y)') - float('$(arg camera_bracket_y)')} ${float('$(arg camera_bracket_upright_z)') - float('$(arg camera_bracket_z)')} 0 0 0</pose>
        <geometry><box><size>$(arg camera_bracket_upright_size_x) $(arg camera_bracket_upright_size_y) $(arg camera_bracket_upright_size_z)</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="top_arm_visual">
        <pose>${float('$(arg camera_bracket_arm_x)') - float('$(arg camera_bracket_x)')} ${float('$(arg camera_bracket_arm_y)') - float('$(arg camera_bracket_y)')} ${float('$(arg camera_bracket_arm_z)') - float('$(arg camera_bracket_z)')} 0 0 0</pose>
        <geometry><box><size>$(arg camera_bracket_arm_size_x) $(arg camera_bracket_arm_size_y) $(arg camera_bracket_arm_size_z)</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <collision name="upright_collision">
        <pose>${float('$(arg camera_bracket_upright_x)') - float('$(arg camera_bracket_x)')} ${float('$(arg camera_bracket_upright_y)') - float('$(arg camera_bracket_y)')} ${float('$(arg camera_bracket_upright_z)') - float('$(arg camera_bracket_z)')} 0 0 0</pose>
        <geometry><box><size>$(arg camera_bracket_upright_size_x) $(arg camera_bracket_upright_size_y) $(arg camera_bracket_upright_size_z)</size></box></geometry>
      </collision>
      <collision name="top_arm_collision">
        <pose>${float('$(arg camera_bracket_arm_x)') - float('$(arg camera_bracket_x)')} ${float('$(arg camera_bracket_arm_y)') - float('$(arg camera_bracket_y)')} ${float('$(arg camera_bracket_arm_z)') - float('$(arg camera_bracket_z)')} 0 0 0</pose>
        <geometry><box><size>$(arg camera_bracket_arm_size_x) $(arg camera_bracket_arm_size_y) $(arg camera_bracket_arm_size_z)</size></box></geometry>
      </collision>
      <!-- Single real-robot-like LED射灯. The source is forward of the
           camera body and on the wall side of the bracket, keeping both
           structures behind the useful light rays. -->
      <light type="spot" name="inspection_led">
        <pose>${float('$(arg inspection_led_x)') - float('$(arg camera_bracket_x)')} ${float('$(arg inspection_led_y)') - float('$(arg camera_bracket_y)')} ${float('$(arg inspection_led_z)') - float('$(arg camera_bracket_z)')} 0 0 0</pose>
        <cast_shadows>$(arg inspection_led_cast_shadows)</cast_shadows>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.08 0.08 0.08 1</specular>
        <intensity>$(arg inspection_led_intensity)</intensity>
        <attenuation>
          <range>$(arg inspection_led_range)</range>
          <constant>$(arg inspection_led_constant)</constant>
          <linear>$(arg inspection_led_linear)</linear>
          <quadratic>$(arg inspection_led_quadratic)</quadratic>
        </attenuation>
        <direction>$(arg inspection_led_direction_x) $(arg inspection_led_direction_y) $(arg inspection_led_direction_z)</direction>
        <spot>
          <inner_angle>$(arg inspection_led_inner_angle)</inner_angle>
          <outer_angle>$(arg inspection_led_outer_angle)</outer_angle>
          <falloff>$(arg inspection_led_falloff)</falloff>
        </spot>
      </light>
    </link>
    <joint name="inspection_camera_bracket_joint" type="fixed">
      <parent>chassis_link</parent>
      <child>inspection_camera_bracket_link</child>
    </joint>

    <link name="inspection_camera_link">
      <pose>$(arg camera_body_x) $(arg camera_body_y) $(arg camera_body_z) 0 0 0</pose>
      <inertial>
        <mass>$(arg camera_body_mass)</mass>
        <inertia>
          <ixx>${camera_body_ixx}</ixx>
          <iyy>${camera_body_iyy}</iyy>
          <izz>${camera_body_izz}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry><box><size>$(arg camera_body_size_x) $(arg camera_body_size_y) $(arg camera_body_size_z)</size></box></geometry>
        <material><ambient>0.03 0.12 0.20 1</ambient><diffuse>0.05 0.20 0.32 1</diffuse></material>
      </visual>
      <visual name="lens_visual">
        <pose>0 0 ${float('$(arg camera_optical_z)') - float('$(arg camera_body_z)') - 0.004} 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.012</length></cylinder></geometry>
        <material><ambient>0.01 0.02 0.03 1</ambient><diffuse>0.02 0.03 0.04 1</diffuse></material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>$(arg camera_body_size_x) $(arg camera_body_size_y) $(arg camera_body_size_z)</size></box></geometry>
      </collision>
      <sensor name="inspection_camera" type="camera">
        <!-- Gazebo cameras look along sensor +X. A +90 degree pitch maps that
             axis to base -Z; image-right then maps to base -Y and image-down
             to base -X, matching inspection_camera_optical_frame. -->
        <pose>0 0 ${float('$(arg camera_optical_z)') - float('$(arg camera_body_z)')} 0 1.5707963267948966 0</pose>
        <always_on>true</always_on>
        <update_rate>$(arg camera_update_rate)</update_rate>
        <visualize>$(arg camera_visualize)</visualize>
        <topic>/simulation/inspection_camera/ideal_image</topic>
        <gz_frame_id>inspection_camera_optical_frame</gz_frame_id>
        <camera>
          <triggered>$(arg camera_triggered)</triggered>
          <trigger_topic>/simulation/inspection_camera/trigger</trigger_topic>
          <camera_info_topic>/simulation/inspection_camera/ideal_camera_info</camera_info_topic>
          <horizontal_fov>$(arg camera_render_hfov)</horizontal_fov>
          <image>
            <width>$(arg camera_image_width)</width>
            <height>$(arg camera_image_height)</height>
            <format>$(arg camera_image_format)</format>
          </image>
          <clip>
            <near>$(arg camera_near_clip)</near>
            <far>$(arg camera_far_clip)</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>$(arg camera_noise_mean)</mean>
            <stddev>$(arg camera_noise_stddev)</stddev>
          </noise>
          <lens>
            <intrinsics>
              <fx>$(arg camera_render_fx)</fx>
              <fy>$(arg camera_render_fy)</fy>
              <cx>$(arg camera_cx)</cx>
              <cy>$(arg camera_cy)</cy>
              <s>$(arg camera_skew)</s>
            </intrinsics>
          </lens>
        </camera>
      </sensor>
    </link>
    <joint name="inspection_camera_joint" type="fixed">
      <parent>chassis_link</parent>
      <child>inspection_camera_link</child>
    </joint>

    <frame name="inspection_camera_optical_frame" attached_to="inspection_camera_link">
      <pose relative_to="__model__">$(arg camera_optical_x) $(arg camera_optical_y) $(arg camera_optical_z) $(arg camera_optical_roll) $(arg camera_optical_pitch) $(arg camera_optical_yaw)</pose>
    </frame>

    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>$(arg wheel_separation)</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/climbot/odometry</odom_topic>
      <tf_topic>/model/climbot/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>$(arg odom_frequency)</odom_publish_frequency>
      <max_linear_velocity>$(arg max_linear_velocity)</max_linear_velocity>
      <min_linear_velocity>${-1.0 * float("$(arg max_linear_velocity)")}</min_linear_velocity>
      <max_angular_velocity>$(arg max_angular_velocity)</max_angular_velocity>
      <min_angular_velocity>${-1.0 * float("$(arg max_angular_velocity)")}</min_angular_velocity>
      <max_linear_acceleration>$(arg max_linear_acceleration)</max_linear_acceleration>
      <min_linear_acceleration>${-1.0 * float("$(arg max_linear_acceleration)")}</min_linear_acceleration>
      <max_angular_acceleration>$(arg max_angular_acceleration)</max_angular_acceleration>
      <min_angular_acceleration>${-1.0 * float("$(arg max_angular_acceleration)")}</min_angular_acceleration>
    </plugin>

    <!-- Wheel angles for robot_state_publisher's TF tree. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/climbot/joint_state</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

    <plugin filename="gz-sim-wheel-slip-system"
            name="gz::sim::systems::WheelSlip">
      <wheel link_name="left_wheel_link">
        <wheel_radius>${wheel_radius}</wheel_radius>
        <wheel_normal_force>$(arg nominal_normal_force)</wheel_normal_force>
        <slip_compliance_lateral>$(arg slip_lateral)</slip_compliance_lateral>
        <slip_compliance_longitudinal>$(arg slip_longitudinal)</slip_compliance_longitudinal>
      </wheel>
      <wheel link_name="right_wheel_link">
        <wheel_radius>${wheel_radius}</wheel_radius>
        <wheel_normal_force>$(arg nominal_normal_force)</wheel_normal_force>
        <slip_compliance_lateral>$(arg slip_lateral)</slip_compliance_lateral>
        <slip_compliance_longitudinal>$(arg slip_longitudinal)</slip_compliance_longitudinal>
      </wheel>
    </plugin>

    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>$(arg odom_frequency)</update_frequency>
    </plugin>

    <!-- Physical world pose only: this is evaluation truth, not an EKF input. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
      <odom_topic>/model/climbot/ground_truth</odom_topic>
      <odom_covariance_topic>/model/climbot/ground_truth_with_covariance</odom_covariance_topic>
    </plugin>
  </model>
</sdf>
