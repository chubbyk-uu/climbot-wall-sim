<?xml version="1.0"?>
<!--
  Rendered at launch time from config/wall.yaml, which is the single source
  of truth for the wall slab and the wall work frame. Nothing here may
  restate a wall dimension as a literal.
-->
<sdf version="1.10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="centre_x" default="0.0"/>
  <xacro:arg name="centre_y" default="0.0"/>
  <xacro:arg name="centre_z" default="4.0"/>
  <xacro:arg name="thickness" default="0.10"/>
  <xacro:arg name="width" default="10.0"/>
  <xacro:arg name="height" default="8.0"/>
  <xacro:arg name="mu" default="1.1"/>
  <xacro:arg name="grid_spacing" default="1.0"/>
  <xacro:arg name="suction_force" default="220.0"/>
  <xacro:arg name="spawn_gap" default="0.001"/>
  <xacro:arg name="spawn_lateral" default="0.0"/>
  <xacro:arg name="spawn_height" default="2.0"/>
  <xacro:arg name="spawn_roll" default="1.5707963267948966"/>
  <xacro:arg name="spawn_pitch" default="0.0"/>
  <xacro:arg name="spawn_yaw" default="1.5707963267948966"/>

  <xacro:property name="centre_x" value="$(arg centre_x)"/>
  <xacro:property name="centre_y" value="$(arg centre_y)"/>
  <xacro:property name="centre_z" value="$(arg centre_z)"/>
  <xacro:property name="thickness" value="$(arg thickness)"/>
  <xacro:property name="width" value="$(arg width)"/>
  <xacro:property name="height" value="$(arg height)"/>
  <xacro:property name="grid_spacing" value="$(arg grid_spacing)"/>
  <!-- Wall face, the plane the wheels roll on, and the grid overlay just
       in front of it so the decals never fight the collision surface. -->
  <xacro:property name="face_x" value="${centre_x + thickness / 2.0}"/>
  <xacro:property name="decal_x" value="${thickness / 2.0 + 0.003}"/>
  <!-- Outermost grid line sits one spacing inside each edge. -->
  <xacro:property name="columns" value="${int(width / (2.0 * grid_spacing)) - 1}"/>
  <xacro:property name="rows" value="${int(height / (2.0 * grid_spacing)) - 1}"/>

  <xacro:macro name="grid_line" params="axis index count">
    <xacro:if value="${index &lt;= 2 * count}">
      <visual name="grid_${axis}_${index}">
        <xacro:if value="${axis == 'column'}">
          <pose>${decal_x} ${(index - count) * grid_spacing} 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.006 ${0.035 if index == count else 0.025} ${height}</size>
            </box>
          </geometry>
        </xacro:if>
        <xacro:unless value="${axis == 'column'}">
          <pose>${decal_x} 0 ${(index - count) * grid_spacing} 0 0 0</pose>
          <geometry>
            <box>
              <size>0.006 ${width} ${0.035 if index == count else 0.025}</size>
            </box>
          </geometry>
        </xacro:unless>
        <material>
          <ambient>${'0.10 0.12 0.16' if index == count else '0.18 0.20 0.24'} 1</ambient>
          <diffuse>${'0.10 0.12 0.16' if index == count else '0.18 0.20 0.24'} 1</diffuse>
        </material>
      </visual>
      <xacro:grid_line axis="${axis}" index="${index + 1}" count="${count}"/>
    </xacro:if>
  </xacro:macro>

  <world name="climbot_wall">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <!-- Required for the wheel contact sensors that record wall normal loads. -->
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-apply-link-wrench-system"
            name="gz::sim::systems::ApplyLinkWrench">
      <persistent>
        <entity_name>climbot</entity_name>
        <entity_type>model</entity_type>
        <!-- Along the inward wall normal, which is world -X for this wall. -->
        <force>${-1.0 * float("$(arg suction_force)")} 0 0</force>
        <torque>0 0 0</torque>
      </persistent>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>4 -2 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-1 0.2 -0.4</direction>
    </light>

    <model name="wall">
      <static>true</static>
      <link name="wall_link">
        <pose>${centre_x} ${centre_y} ${centre_z} 0 0 0</pose>
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>${thickness} ${width} ${height}</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>$(arg mu)</mu>
                <mu2>$(arg mu)</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="wall_visual">
          <geometry>
            <box>
              <size>${thickness} ${width} ${height}</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.64 0.68 1</ambient>
            <diffuse>0.72 0.74 0.78 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
        <!-- High-contrast reference grid on the wall front face. -->
        <xacro:grid_line axis="column" index="0" count="${columns}"/>
        <xacro:grid_line axis="row" index="0" count="${rows}"/>
      </link>
    </model>

    <include>
      <uri>model://climbot</uri>
      <!-- On the wall face, oriented so the robot's axes match the wall
           work frame: local +X -> wall +X, +Y -> wall +Y, +Z -> wall normal. -->
      <pose>${face_x + float("$(arg spawn_gap)")} $(arg spawn_lateral) $(arg spawn_height)
            $(arg spawn_roll) $(arg spawn_pitch) $(arg spawn_yaw)</pose>
    </include>

    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Climbot Wall Simulation</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.12 0.14 0.18</background_color>
        <!-- Front-on view centred on the robot's initial pose. -->
        <camera_pose>${face_x + 2.75} $(arg spawn_lateral) $(arg spawn_height) 0 0 3.14159265359</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked</property>
          <property type="double" key="width">260</property>
        </gz-gui>
      </plugin>
      <plugin filename="ComponentInspector" name="Component inspector">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>
  </world>
</sdf>
